msgstr "Velocidad de reproducción"

#, python-format
msgid ""
"For the selected country. Every file is public at a stable URL, under "
"<code>%(outputs_base)s</code>."
msgstr ""
"Para el país seleccionado. Cada archivo es público en una dirección estable,"
" bajo <code>%(outputs_base)s</code>."

